digraph G {
  graph [rankdir=TB, nodesep=0.35, ranksep=0.35, newrank=true, fontname="Liberation Serif", bgcolor="white", pad=0.2];
  node [fontname="Liberation Serif", fontsize=11, margin="0.15,0.07", width=2.3];
  edge [color="#6B7280", arrowsize=0.7, penwidth=1.1];
  subgraph cluster_design { label=<<b>1 · Research design</b>>; fontsize=13; fontcolor="#4338CA"; style="rounded"; color="#4338CA"; penwidth=1.0;
    d1 [label=<<b>Problem &amp; RQ1–RQ4</b><br/><font point-size='9'>leakage-free early warning</font>>, shape=box, style="rounded,filled", fillcolor="#EEF2FF", color="#4338CA", fontcolor="#111827", penwidth=1.3];
    d2 [label=<<b>Literature review</b><br/><font point-size='9'>XAI-in-education gaps</font>>, shape=box, style="rounded,filled", fillcolor="#EEF2FF", color="#4338CA", fontcolor="#111827", penwidth=1.3];
    d3 [label=<<b>Primary data collection</b><br/><font point-size='9'>N = 1,208 students, 13 predictors</font>>, shape=box, style="rounded,filled", fillcolor="#EEF2FF", color="#4338CA", fontcolor="#111827", penwidth=1.3];
    d1 -> d2;
    d2 -> d3;
  }
  subgraph cluster_data { label=<<b>2 · Data preparation</b>>; fontsize=13; fontcolor="#047857"; style="rounded"; color="#047857"; penwidth=1.0;
    p1 [label=<<b>Audit &amp; cleaning</b><br/><font point-size='9'>missing → 'Unknown', types, ranges</font>>, shape=box, style="rounded,filled", fillcolor="#ECFDF5", color="#047857", fontcolor="#111827", penwidth=1.3];
    p2 [label=<<b>Target construction</b><br/><font point-size='9'>At-Risk = last-term % ≤ 50 (5.5%)</font>>, shape=box, style="rounded,filled", fillcolor="#ECFDF5", color="#047857", fontcolor="#111827", penwidth=1.3];
    p3 [label=<<b>Leakage removal</b><br/><font point-size='9'>drop LastTerm%, Grade</font>>, shape=box, style="rounded,filled", fillcolor="#ECFDF5", color="#047857", fontcolor="#111827", penwidth=1.3];
    p4 [label=<<b>Encoding</b><br/><font point-size='9'>one-hot nominal · ordinal · Min–Max</font>>, shape=box, style="rounded,filled", fillcolor="#ECFDF5", color="#047857", fontcolor="#111827", penwidth=1.3];
    p1 -> p2;
    p2 -> p3;
    p3 -> p4;
  }
  subgraph cluster_model { label=<<b>3 · Modelling &amp; evaluation</b>>; fontsize=13; fontcolor="#1D4ED8"; style="rounded"; color="#1D4ED8"; penwidth=1.0;
    m1 [label=<<b>Six classifiers</b><br/><font point-size='9'>LR · SVM · RF · DT · GB · XGB</font>>, shape=box, style="rounded,filled", fillcolor="#EFF6FF", color="#1D4ED8", fontcolor="#111827", penwidth=1.3];
    m2 [label=<<b>Nested 10×10 repeated CV</b><br/><font point-size='9'>inner GridSearch (PR-AUC) + threshold</font>>, shape=box, style="rounded,filled", fillcolor="#EFF6FF", color="#1D4ED8", fontcolor="#111827", penwidth=1.3];
    m3 [label=<<b>Imbalance &amp; synthetic-data<br/>sensitivity</b><br/><font point-size='9'>7 strategies · CTGAN/TVAE/Copula (train-only)</font>>, shape=box, style="rounded,filled", fillcolor="#EFF6FF", color="#1D4ED8", fontcolor="#111827", penwidth=1.3];
    m4 [label=<<b>Statistical comparison</b><br/><font point-size='9'>corrected t · Friedman–Nemenyi · DeLong</font>>, shape=box, style="rounded,filled", fillcolor="#EFF6FF", color="#1D4ED8", fontcolor="#111827", penwidth=1.3];
    m5 [label=<<b>Calibration · DCA · fairness</b>>, shape=box, style="rounded,filled", fillcolor="#EFF6FF", color="#1D4ED8", fontcolor="#111827", penwidth=1.3];
    m1 -> m2;
    m2 -> m3;
    m3 -> m4;
    m4 -> m5;
  }
  subgraph cluster_xai { label=<<b>4 · Explainability (PREX-Edu)</b>>; fontsize=13; fontcolor="#B91C1C"; style="rounded"; color="#B91C1C"; penwidth=1.0;
    x1 [label=<<b>SHAP · LIME · PDP · PFI</b><br/><font point-size='9'>stability, agreement</font>>, shape=box, style="rounded,filled", fillcolor="#FEF2F2", color="#B91C1C", fontcolor="#111827", penwidth=1.3];
    x2 [label=<<b>PREX-Edu aggregation</b><br/><font point-size='9'>4 pedagogical dimensions (Σ|SHAP|)</font>>, shape=box, style="rounded,filled", fillcolor="#FEF2F2", color="#B91C1C", fontcolor="#111827", penwidth=1.3];
    x3 [label=<<b>Faithfulness &amp; actionability</b><br/><font point-size='9'>ablation · AOPC · counterfactuals</font>>, shape=box, style="rounded,filled", fillcolor="#FEF2F2", color="#B91C1C", fontcolor="#111827", penwidth=1.3];
    x4 [label=<<b>Educator validation</b><br/><font point-size='9'>pilot + powered replication design</font>>, shape=box, style="rounded,filled", fillcolor="#FEF2F2", color="#B91C1C", fontcolor="#111827", penwidth=1.3];
    x1 -> x2;
    x2 -> x3;
    x3 -> x4;
  }
  subgraph cluster_report { label=<<b>5 · Reporting</b>>; fontsize=13; fontcolor="#4D7C0F"; style="rounded"; color="#4D7C0F"; penwidth=1.0;
    r1 [label=<<b>Results &amp; discussion</b>>, shape=box, style="rounded,filled", fillcolor="#F7FEE7", color="#4D7C0F", fontcolor="#111827", penwidth=1.3];
    r2 [label=<<b>Limitations &amp; future work</b>>, shape=box, style="rounded,filled", fillcolor="#F7FEE7", color="#4D7C0F", fontcolor="#111827", penwidth=1.3];
    r1 -> r2;
  }
  {rank=same; d1; p1; m1; x1; r1;}
  d3 -> p1 [constraint=false];
  p4 -> m1 [constraint=false];
  m5 -> x1 [constraint=false];
  x4 -> r1 [constraint=false];
  m4 -> m2 [style=dashed, label=<<font point-size="8">re-tune</font>>, constraint=false];
  x3 -> x2 [style=dashed, constraint=false];
}